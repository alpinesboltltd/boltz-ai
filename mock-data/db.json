  "messages": [
    {
      "id": "msg_012",
      "convo_id": "convo_3",
      "role": "user",
      "text": "I want to apply for a business loan for my restaurant",
      "timestamp": "2025-07-01T10:02:00Z",
      "confidence_score": 0.88
    },
    {
      "id": "msg_013",
      "convo_id": "convo_3",
      "role": "assistant",
      "text": "That's wonderful! I'd be happy to help you with your business loan application. For restaurant businesses, we offer competitive rates starting at 6.5% APR. You'll need your business license, tax returns for the last 2 years, financial statements, and a business plan. The typical loan amount ranges from $50,000 to $500,000. Would you like me to connect you with our business loan specialist to discuss your specific needs?",
      "confidence_score": 0.91,
      "timestamp": "2025-07-01T10:03:00Z"
    },
    {
      "id": "msg_014",
      "convo_id": "convo_3",
      "role": "user",
      "text": "Yes, that would be great. I'm looking for around $200,000",
      "timestamp": "2025-07-01T10:04:00Z",
      "confidence_score": 0.99
    },
    {
      "id": "msg_015",
      "convo_id": "convo_3",
      "role": "assistant",
      "text": "Perfect! $200,000 is well within our lending range for established restaurants. I'm scheduling you for a consultation with Maria Rodriguez, our senior business loan officer. She has availability tomorrow at 11:00 AM or Thursday at 3:00 PM. She'll review your documents and discuss terms, repayment options, and next steps. Which time works better for you?",
      "confidence_score": 0.89,
      "timestamp": "2025-07-01T10:05:00Z"
    },
    {
      "id": "msg_017",
      "convo_id": "convo_4",
      "role": "user",
      "text": "I'm interested in your data science certification program",
      "timestamp": "2025-07-01T10:02:00Z",
      "confidence_score": 0.88
    },
    {
      "id": "msg_018",
      "convo_id": "convo_4",
      "role": "assistant",
      "text": "Excellent choice! Our Data Science Certification is a comprehensive 6-month program covering Python, machine learning, statistics, and real-world projects. The program includes 120 hours of instruction, mentorship, and career support. The next cohort starts August 15th, and early bird pricing is $2,499 (regular price $2,999). We also offer payment plans. Would you like me to send you the detailed curriculum?",
      "confidence_score": 0.93,
      "timestamp": "2025-07-01T10:03:00Z"
    },
    {
      "id": "msg_019",
      "convo_id": "convo_4",
      "role": "user",
      "text": "Yes, please send the curriculum. Also, do you offer job placement assistance?",
      "timestamp": "2025-07-01T10:04:00Z",
      "confidence_score": 0.99
    },
    {
      "id": "msg_020",
      "convo_id": "convo_4",
      "role": "assistant",
      "text": "Absolutely! I'll email you the complete curriculum within the next 10 minutes. Yes, we provide comprehensive career support including resume review, interview preparation, and access to our partner network of 200+ hiring companies. Our job placement rate is 87% within 6 months of graduation. We also offer a job guarantee - if you don't find a position within 12 months, we'll refund 50% of your tuition. Would you like to schedule a call with our admissions counselor?",
      "confidence_score": 0.96,
      "timestamp": "2025-07-01T10:05:00Z"
    }
  ],
